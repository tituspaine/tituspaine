{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tituspaine-intel",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://intel.tituspaine.com",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intel-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "intel-evidence"
    }
  ]
}
